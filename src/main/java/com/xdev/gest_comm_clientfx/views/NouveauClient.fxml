<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.xdev.gest_comm_clientfx.controllers.NouveauClientCtrl"
      spacing="10.0"
      style="-fx-padding: 20;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Nouveau client" style="-fx-font-weight: bold;" />

    <GridPane hgap="10.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraint minWidth="130.0" prefWidth="130.0" />
            <ColumnConstraint hgrow="ALWAYS" />
        </columnConstraints>
        <Label text="Code *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="codeClientField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Nom et prénom *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="nomPrenomField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Mat. fiscale *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="matFiscalField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Adresse 1 *" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="adresse1Field" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label text="Adresse 2" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="adresse2Field" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Label text="Tél. 1" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="tel1Field" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        <Label text="Tél. 2" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="tel2Field" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    </GridPane>

    <HBox spacing="10.0">
        <Button mnemonicParsing="false" onAction="#save" text="Enregistrer" />
        <Button mnemonicParsing="false" onAction="#cancel" text="Annuler" />
    </HBox>

    <Label fx:id="statusLabel" text="" wrapText="true" />
</VBox>
