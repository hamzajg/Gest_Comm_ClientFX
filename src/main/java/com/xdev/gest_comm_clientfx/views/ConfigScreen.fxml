<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Connection settings: the account itself is entered on the login gate,
     never stored here (specs/login-profile-settings D3). -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.xdev.gest_comm_clientfx.controllers.ConfigScreenCtrl"
      spacing="10.0"
      styleClass="form-panel">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="form-title" text="Paramètres de l'application — serveur PyGestComm" />

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="110.0" prefWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <Label text="Serveur (URL)" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="baseUrlField" promptText="http://localhost:8000"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" />
    </GridPane>

    <HBox spacing="10.0">
        <Button mnemonicParsing="false" onAction="#saveConfig" styleClass="primary" text="Enregistrer" />
        <Button mnemonicParsing="false" onAction="#testConnection" text="Tester la connexion" />
        <Button mnemonicParsing="false" onAction="#closeWindow" text="Fermer" />
    </HBox>

    <Label fx:id="statusLabel" styleClass="status" text="" wrapText="true" />
</VBox>
