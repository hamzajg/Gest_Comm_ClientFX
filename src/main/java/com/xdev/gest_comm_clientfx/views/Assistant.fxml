<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.xdev.gest_comm_clientfx.controllers.AssistantCtrl"
      spacing="8.0"
      styleClass="form-panel">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <Label text="Assistant" styleClass="form-title" />
    <Label text="Posez une question sur les clients, articles, devis ou factures — ex. « combien de clients », « trouver devis D001 »." wrapText="true" />

    <HBox spacing="8.0">
        <TextField fx:id="questionField" HBox.hgrow="ALWAYS"
                   promptText="Votre question…" />
        <Button mnemonicParsing="false" onAction="#ask" text="Poser" />
    </HBox>

    <TextArea fx:id="logArea" editable="false" wrapText="true"
              VBox.vgrow="ALWAYS" prefRowCount="12" />

    <Label fx:id="statusLabel" text="" wrapText="true" />
</VBox>
