<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- The signed-in account (specs/login-profile-settings US3, US4, US5, US6):
     identity and role, local appearance/language, password change and sign
     out. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.xdev.gest_comm_clientfx.controllers.ProfileCtrl"
      spacing="14.0"
      styleClass="form-panel">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="form-title" text="%profile.title" />

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="160.0" prefWidth="160.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <Label text="%profile.name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="nameLabel" styleClass="profile-value"
               GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="%profile.username" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="usernameLabel" styleClass="profile-value"
               GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="%profile.email" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label fx:id="emailLabel" styleClass="profile-value"
               GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="%profile.role" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <Label fx:id="roleLabel" styleClass="role-badge"
               GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <Label styleClass="profile-note" wrapText="true" text="%profile.note" />

    <HBox spacing="10.0">
        <Button fx:id="signOutButton" mnemonicParsing="false"
                onAction="#signOut" text="%profile.signout" />
    </HBox>

    <Separator />

    <Label styleClass="form-title" text="%profile.appearance" />
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="160.0" prefWidth="160.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <Label text="%profile.theme" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="themeBox" maxWidth="220.0"
                  GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="%profile.language" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="languageBox" maxWidth="220.0"
                  GridPane.columnIndex="1" GridPane.rowIndex="1" />
    </GridPane>

    <Separator />

    <Label styleClass="form-title" text="%password.title" />
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="160.0" prefWidth="160.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <Label text="%password.current" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <PasswordField fx:id="currentPasswordField"
                       GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="%password.new" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <PasswordField fx:id="newPasswordField"
                       GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="%password.confirm" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <PasswordField fx:id="confirmPasswordField"
                       GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <HBox spacing="10.0">
        <Button fx:id="changePasswordButton" mnemonicParsing="false"
                onAction="#changePassword" text="%password.submit" />
    </HBox>

    <Label fx:id="statusLabel" styleClass="status" text="" wrapText="true" />
</VBox>
