<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!--
  Home shell: the tab pane is the workspace, filled at runtime by
  HomeScreenCtrl. The panelStore below is a hidden holder only - each panel
  in it is lifted into a tab when its menu item is clicked, which keeps the
  tables and their fx:id wiring in one place.
-->
<VBox xmlns="http://javafx.com/javafx/8.0.121" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.xdev.gest_comm_clientfx.controllers.HomeScreenCtrl">

    <MenuBar>
        <menus>
            <Menu mnemonicParsing="false" text="Application">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showWelcome" text="Bienvenue" />
                    <MenuItem mnemonicParsing="false" onAction="#showProfile" text="Mon profil" />
                    <MenuItem mnemonicParsing="false" onAction="#openConfig" text="Parametre de l'application" />
                    <MenuItem mnemonicParsing="false" onAction="#toggleDrawer" text="Panneau d'actions" />
                    <SeparatorMenuItem/>
                    <MenuItem mnemonicParsing="false" onAction="#logout" text="Se déconnecter" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Article">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showNewArticle" text="Nouveau article" />
                    <MenuItem mnemonicParsing="false" onAction="#showArticles" text="Liste des articles" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Client">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showNewClient" text="Nouveau client" />
                    <MenuItem mnemonicParsing="false" onAction="#showClients" text="Liste des clients" />
                    <SeparatorMenuItem/>
                    <MenuItem mnemonicParsing="false" onAction="#showNewBonLiv" text="Nouveau Bon Liv" />
                    <MenuItem mnemonicParsing="false" onAction="#showBonLivs" text="Liste des Bon Livs" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Devis">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showNewDevis" text="Nouveau devis" />
                    <MenuItem mnemonicParsing="false" onAction="#showDevis" text="Liste des devis" />
                    <SeparatorMenuItem/>
                    <MenuItem mnemonicParsing="false" onAction="#convertSelectedDevis" text="Convertir en facture" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Facture">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showNewFacture" text="Nouvelle facture" />
                    <MenuItem mnemonicParsing="false" onAction="#showFactures" text="Liste des factures" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Help">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showAssistant" text="Assistant" />
                </items>
            </Menu>
        </menus>
    </MenuBar>

    <HBox styleClass="search-bar" spacing="6.0" alignment="CENTER_LEFT">
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
        </padding>
        <TextField fx:id="searchField" styleClass="search-field" text="Recherche" HBox.hgrow="ALWAYS" />
        <Label fx:id="searchScope" styleClass="status" text="" />
    </HBox>

    <BorderPane VBox.vgrow="ALWAYS">
        <center>
            <TabPane fx:id="tabs" tabClosingPolicy="ALL_TABS" />
        </center>
        <right>
            <VBox fx:id="drawerHost" />
        </right>
    </BorderPane>

    <!-- Hidden panel holders: lifted into tabs on demand. -->
    <VBox fx:id="panelStore" managed="false" visible="false">
        <VBox fx:id="clientsPanel" spacing="5.0">
            <TableView fx:id="clientTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="clientStatus" styleClass="status" text="" />
        </VBox>
        <VBox fx:id="articlesPanel" spacing="5.0">
            <TableView fx:id="articleTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="articleStatus" styleClass="status" text="" />
        </VBox>
        <VBox fx:id="devisPanel" spacing="5.0">
            <TableView fx:id="devisTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="devisStatus" styleClass="status" text="" />
        </VBox>
        <VBox fx:id="facturesPanel" spacing="5.0">
            <TableView fx:id="factureTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="factureStatus" styleClass="status" text="" />
        </VBox>
        <VBox fx:id="bonlivsPanel" spacing="5.0">
            <TableView fx:id="bonlivTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="bonlivStatus" styleClass="status" text="" />
        </VBox>
    </VBox>
</VBox>
