<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!--
  Home shell: the tab pane is the workspace, filled at runtime by
  HomeScreenCtrl. The panelStore below is a hidden holder only - each panel
  in it is lifted into a tab when its menu item is clicked, which keeps the
  tables and their fx:id wiring in one place.
-->
<VBox xmlns="http://javafx.com/javafx/8.0.121" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.xdev.gest_comm_clientfx.controllers.HomeScreenCtrl">

    <MenuBar>
        <menus>
            <Menu mnemonicParsing="false" text="%menu.application">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showWelcome" text="%menu.welcome" />
                    <MenuItem mnemonicParsing="false" onAction="#showProfile" text="%menu.profile" />
                    <MenuItem mnemonicParsing="false" onAction="#openConfig" text="%menu.settings" />
                    <MenuItem mnemonicParsing="false" onAction="#toggleDrawer" text="%menu.drawer" />
                    <SeparatorMenuItem/>
                    <MenuItem mnemonicParsing="false" onAction="#logout" text="%menu.signout" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="%menu.article">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showNewArticle" text="%menu.newArticle" />
                    <MenuItem mnemonicParsing="false" onAction="#showArticles" text="%menu.articles" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="%menu.client">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showNewClient" text="%menu.newClient" />
                    <MenuItem mnemonicParsing="false" onAction="#showClients" text="%menu.clients" />
                    <SeparatorMenuItem/>
                    <MenuItem mnemonicParsing="false" onAction="#showNewBonLiv" text="%menu.newBonLiv" />
                    <MenuItem mnemonicParsing="false" onAction="#showBonLivs" text="%menu.bonLivs" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="%menu.devis">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showNewDevis" text="%menu.newDevis" />
                    <MenuItem mnemonicParsing="false" onAction="#showDevis" text="%menu.devisList" />
                    <SeparatorMenuItem/>
                    <MenuItem mnemonicParsing="false" onAction="#convertSelectedDevis" text="%menu.convert" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="%menu.facture">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showNewFacture" text="%menu.newFacture" />
                    <MenuItem mnemonicParsing="false" onAction="#showFactures" text="%menu.factures" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="%menu.help">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#showAssistant" text="%menu.assistant" />
                </items>
            </Menu>
        </menus>
    </MenuBar>

    <HBox styleClass="search-bar" spacing="6.0" alignment="CENTER_LEFT">
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
        </padding>
        <TextField fx:id="searchField" promptText="%search.prompt" styleClass="search-field" HBox.hgrow="ALWAYS" />
        <Label fx:id="searchScope" styleClass="status" text="" />
    </HBox>

    <BorderPane VBox.vgrow="ALWAYS">
        <center>
            <TabPane fx:id="tabs" tabClosingPolicy="ALL_TABS" />
        </center>
        <right>
            <VBox fx:id="drawerHost" />
        </right>
    </BorderPane>

    <!-- Hidden panel holders: lifted into tabs on demand. -->
    <VBox fx:id="panelStore" managed="false" visible="false">
        <VBox fx:id="clientsPanel" spacing="5.0">
            <TableView fx:id="clientTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="clientStatus" styleClass="status" text="" />
        </VBox>
        <VBox fx:id="articlesPanel" spacing="5.0">
            <TableView fx:id="articleTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="articleStatus" styleClass="status" text="" />
        </VBox>
        <VBox fx:id="devisPanel" spacing="5.0">
            <TableView fx:id="devisTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="devisStatus" styleClass="status" text="" />
        </VBox>
        <VBox fx:id="facturesPanel" spacing="5.0">
            <TableView fx:id="factureTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="factureStatus" styleClass="status" text="" />
        </VBox>
        <VBox fx:id="bonlivsPanel" spacing="5.0">
            <TableView fx:id="bonlivTable" VBox.vgrow="ALWAYS" />
            <Label fx:id="bonlivStatus" styleClass="status" text="" />
        </VBox>
    </VBox>
</VBox>
