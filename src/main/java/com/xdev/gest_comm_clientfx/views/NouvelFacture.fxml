<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.xdev.gest_comm_clientfx.controllers.NouvelFactureCtrl"
      spacing="8.0"
      styleClass="form-panel" maxWidth="900.0">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <Label text="%form.facture.new" styleClass="form-title" />

    <GridPane hgap="10.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <Label text="%field.codeFacture" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="codeFactureField" promptText="%field.codeFactureHint"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="%field.client" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="clientCombo" maxWidth="1.7976931348623157E308"
                  GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="%field.quote" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="devisCombo" maxWidth="1.7976931348623157E308"
                  GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="%field.date" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="dateFactureField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label text="%field.status" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <ComboBox fx:id="statutCombo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Label text="%field.observation" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="observationField" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    </GridPane>

    <Label text="%form.lines" styleClass="form-title" />

    <TableView fx:id="linesTable" prefHeight="140.0">
        <columns>
            <TableColumn fx:id="colDesignation" text="%line.designation" prefWidth="170.0" />
            <TableColumn fx:id="colQuantite" text="%line.quantity" prefWidth="60.0" />
            <TableColumn fx:id="colPrix" text="%line.unitPrice" prefWidth="80.0" />
            <TableColumn fx:id="colRemise" text="%line.discount" prefWidth="80.0" />
            <TableColumn fx:id="colTva" text="%line.vat" prefWidth="60.0" />
        </columns>
    </TableView>

    <GridPane hgap="6.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="28.5" />
            <ColumnConstraints percentWidth="14.3" />
            <ColumnConstraints percentWidth="14.3" />
            <ColumnConstraints percentWidth="14.3" />
            <ColumnConstraints percentWidth="14.3" />
            <ColumnConstraints percentWidth="14.3" />
        </columnConstraints>
        <ComboBox fx:id="articleCombo" promptText="%field.articleOptional"
                  GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="quantiteField" promptText="%field.quantity"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <TextField fx:id="prixField" promptText="%field.price"
                   GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="remiseField" promptText="%field.discount"
                   GridPane.columnIndex="3" GridPane.rowIndex="0" />
        <TextField fx:id="tvaField" promptText="%field.vat"
                   GridPane.columnIndex="4" GridPane.rowIndex="0" />
        <Button mnemonicParsing="false" onAction="#addLine" text="%form.lines.add"
                GridPane.columnIndex="5" GridPane.rowIndex="0" />
        <TextField fx:id="designationField" promptText="%field.designationOrArticle"
                   GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="6" />
    </GridPane>

    <HBox spacing="10.0">
        <Button mnemonicParsing="false" onAction="#removeLine" text="%form.lines.remove" />
        <Label fx:id="totalsLabel" text="%form.totals.initial" />
    </HBox>

    <HBox spacing="10.0">
        <Button mnemonicParsing="false" onAction="#save" styleClass="primary" text="%form.save" />
        <Button mnemonicParsing="false" onAction="#cancel" text="%form.cancel" />
    </HBox>

    <Label fx:id="statusLabel" text="" wrapText="true" />
</VBox>
